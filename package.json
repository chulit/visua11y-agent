{
  "name": "visua11y-agent",
  "type": "module",
  "version": "1.8.0",
  "description": "Zero-dependency universal accessibility (a11y) website widget and toolbar for WCAG 2.1 & ADA compliance, high contrast, dyslexia fonts, screen reader, and voice navigation.",
  "keywords": [
    "accessibility",
    "a11y",
    "accessibility-widget",
    "accessibility-toolbar",
    "wcag",
    "wcag21",
    "ada-compliance",
    "screen-reader",
    "voice-navigation",
    "dyslexia-font",
    "high-contrast",
    "web-accessibility",
    "a11y-agent",
    "reading-guide",
    "zero-dependency",
    "userway-alternative"
  ],
  "main": "dist/visua11y-agent.cjs.js",
  "module": "dist/visua11y-agent.esm.js",
  "unpkg": "dist/visua11y-agent.umd.js",
  "jsdelivr": "dist/visua11y-agent.umd.js",
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/visua11y-agent.esm.js",
      "require": "./dist/visua11y-agent.cjs.js"
    },
    "./core": {
      "types": "./types/index.d.ts",
      "import": "./dist/visua11y-agent.esm.js",
      "require": "./dist/visua11y-agent.cjs.js"
    },
    "./slim": {
      "types": "./types/index.d.ts",
      "import": "./dist/visua11y-agent.slim.esm.js",
      "require": "./dist/visua11y-agent.slim.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode slim && node scripts/copy-locales.js",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.js",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "release": "semantic-release",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:build-demo": "node scripts/build-demo.js",
    "docs:publish": "npm run build && npm run docs:build-demo && npm run docs:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chulit/visua11y-agent.git"
  },
  "author": "Chulit",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chulit/visua11y-agent/issues"
  },
  "homepage": "https://chulit.github.io/visua11y-agent/",
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@vitest/ui": "^4.0.5",
    "eslint": "^9.38.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.5"
  }
}